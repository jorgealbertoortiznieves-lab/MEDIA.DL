{
  "name": "mediadl",
  "version": "2.0.0",
  "description": "MEDIA.DL v2.0 - Background Multimedia Downloader (System Tray)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "set NODE_TLS_REJECT_UNAUTHORIZED=0&& electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mediadl.app",
    "productName": "MEDIA.DL",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}